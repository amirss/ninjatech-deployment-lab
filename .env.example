# Application
NINJATECH_APP_NAME=NinjaTech Deployment Lab
NINJATECH_ENVIRONMENT=development
NINJATECH_LOG_LEVEL=INFO
NINJATECH_DB_READY_TIMEOUT_SECONDS=2.0

# Worker execution
NINJATECH_WORKER_POLL_INTERVAL_SECONDS=1.0
NINJATECH_WORKER_LEASE_DURATION_SECONDS=30.0
NINJATECH_WORKER_HEARTBEAT_INTERVAL_SECONDS=10.0
NINJATECH_WORKER_HANDLER_TIMEOUT_SECONDS=300.0
NINJATECH_WORKER_SHUTDOWN_GRACE_SECONDS=20.0
NINJATECH_WORKER_DEFAULT_MAX_ATTEMPTS=3
NINJATECH_WORKER_RETRY_BASE_SECONDS=2.0
NINJATECH_WORKER_RETRY_CAP_SECONDS=300.0
NINJATECH_WORKER_MAX_RESULT_BYTES=262144

# Non-production only. Settings reject true in staging or production.
NINJATECH_ENABLE_DIAGNOSTIC_HANDLER=false

# Local PostgreSQL container
POSTGRES_USER=ninjatech
POSTGRES_PASSWORD=replace-this-local-password
POSTGRES_DB=ninjatech
POSTGRES_PORT=5432

# Use hostname "db" from Docker Compose. Use "localhost" when running the API on the host.
NINJATECH_DATABASE_URL=postgresql+asyncpg://ninjatech:replace-this-local-password@db:5432/ninjatech
APP_PORT=8000
