# Application
NINJATECH_APP_NAME=NinjaTech Deployment Lab
NINJATECH_ENVIRONMENT=development
NINJATECH_LOG_LEVEL=INFO
NINJATECH_DB_READY_TIMEOUT_SECONDS=2.0

# Worker execution
NINJATECH_WORKER_POLL_INTERVAL_SECONDS=1.0
NINJATECH_WORKER_LEASE_DURATION_SECONDS=30.0
NINJATECH_WORKER_HEARTBEAT_INTERVAL_SECONDS=10.0
NINJATECH_WORKER_HANDLER_TIMEOUT_SECONDS=300.0
NINJATECH_WORKER_SHUTDOWN_GRACE_SECONDS=20.0
NINJATECH_WORKER_DEFAULT_MAX_ATTEMPTS=3
NINJATECH_WORKER_RETRY_BASE_SECONDS=2.0
NINJATECH_WORKER_RETRY_CAP_SECONDS=300.0
NINJATECH_WORKER_MAX_RESULT_BYTES=262144

# Non-production only. Settings reject true in staging or production.
NINJATECH_ENABLE_DIAGNOSTIC_HANDLER=false

# Milestone 4A deterministic integration workflow. Keep false outside a controlled
# development/test/demo/sandbox. Settings reject true in staging or production.
NINJATECH_ENABLE_DEPLOYMENT_CONTEXT_SYNC=false
NINJATECH_DEPLOYMENT_SCOPE_ID=local-demo
NINJATECH_DEPLOYMENT_ALLOWED_SERVICE_IDS=["payments-api"]
NINJATECH_DEPLOYMENT_ALLOWED_GITHUB_REPOSITORIES=["customer/example-service"]
NINJATECH_DEPLOYMENT_ALLOWED_JIRA_PROJECTS=["ENG"]
NINJATECH_DEPLOYMENT_MINIMUM_POLICY_VERSION=1
NINJATECH_SERVICE_CATALOG_BASE_URL=http://simulator:8090/catalog
NINJATECH_JIRA_BASE_URL=http://simulator:8090/jira
NINJATECH_GITHUB_BASE_URL=http://simulator:8090/github
# Required whenever deployment_context_sync is enabled; compared case-insensitively.
NINJATECH_GITHUB_EXPECTED_LOGIN=simulator-bot
NINJATECH_INTEGRATION_PROVIDER_WRITE_TIMEOUT_SECONDS=8.0
NINJATECH_INTEGRATION_SETTLEMENT_DELAY_SECONDS=3.0

# Use environment values OR mounted files, never both. These placeholders are not secrets.
NINJATECH_SERVICE_CATALOG_TOKEN=replace-with-local-sandbox-token
NINJATECH_JIRA_API_TOKEN=replace-with-local-sandbox-token
# Optional Jira basic-auth username; omit to use bearer-token sandbox authentication.
# NINJATECH_JIRA_USERNAME=sandbox-user@example.test
NINJATECH_GITHUB_TOKEN=replace-with-local-sandbox-token

# Local PostgreSQL container
POSTGRES_USER=ninjatech
POSTGRES_PASSWORD=replace-this-local-password
POSTGRES_DB=ninjatech
POSTGRES_PORT=5432

# Use hostname "db" from Docker Compose. Use "localhost" when running the API on the host.
NINJATECH_DATABASE_URL=postgresql+asyncpg://ninjatech:replace-this-local-password@db:5432/ninjatech
APP_PORT=8000
